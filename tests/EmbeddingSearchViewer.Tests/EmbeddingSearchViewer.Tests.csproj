<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.1" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WinUI app project cannot be referenced from a plain net10.0 test project; this view model has no UI dependencies. -->
    <Compile Include="..\..\src\EmbeddingSearchViewer.App\ViewModels\SearchViewModel.cs" Link="Linked\SearchViewModel.cs" />
    <Compile Include="..\..\src\EmbeddingSearchViewer.App\ViewModels\ModelSetupViewModel.cs" Link="Linked\ModelSetupViewModel.cs" />
    <Compile Include="..\..\src\EmbeddingSearchViewer.App\ViewModels\SettingsViewModel.cs" Link="Linked\SettingsViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EmbeddingSearchViewer.Core\EmbeddingSearchViewer.Core.csproj" />
    <ProjectReference Include="..\..\src\EmbeddingSearchViewer.Infrastructure\EmbeddingSearchViewer.Infrastructure.csproj" />
  </ItemGroup>

</Project>