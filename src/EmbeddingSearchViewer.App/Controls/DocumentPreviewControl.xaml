<UserControl
    x:Class="EmbeddingSearchViewer_App.Controls.DocumentPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:EmbeddingSearchViewer_App.Localization"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="FileNameTextBlock" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LocationTextBlock" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OpenInExplorerButton_Click" AutomationProperties.Name="Show in Explorer">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock loc:L.Uid="PdfPreview.TextBlock02" />
                    </StackPanel>
                </Button>
                <Button Click="OpenExternalButton_Click" AutomationProperties.Name="Open in External App">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                        <TextBlock loc:L.Uid="PdfPreview.TextBlock01" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="MessageTextBlock" Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12">
            <TextBlock x:Name="BodyTextBlock" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </ScrollViewer>
    </Grid>
</UserControl>
