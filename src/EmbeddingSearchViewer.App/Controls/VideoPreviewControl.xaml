<UserControl
    x:Class="EmbeddingSearchViewer_App.Controls.VideoPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12">
        <!-- Top Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="JumpToHitButton" Click="JumpToHitButton_Click" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Jump to Match Moment">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock x:Name="HitMomentTextBlock" Text="一致箇所へジャンプ (00:00)" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Column="2" x:Name="OpenVideoExternalButton" Click="OpenVideoExternalButton_Click" ToolTipService.ToolTip="既定のメディアプレイヤーで開く" AutomationProperties.Name="Open in External App">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    <TextBlock Text="外部アプリで再生" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Media Player (Fit to Viewport, Aspect Ratio Preserved, No Scroll) -->
        <MediaPlayerElement Grid.Row="1" x:Name="PlayerElement" AreTransportControlsEnabled="True"
                            Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Bottom Segment Info -->
        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
            <TextBlock x:Name="FileInfoTextBlock" Text="動画ファイル情報" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>
    </Grid>
</UserControl>
