<UserControl
    x:Class="EmbeddingSearchViewer_App.Controls.ImagePreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:EmbeddingSearchViewer_App.Localization"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8"
          PointerEntered="RootGrid_PointerEntered" PointerExited="RootGrid_PointerExited">
        <!-- Main Image: Occupies 100% of the viewport area, aspect ratio preserved, no scrolling -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
            <ScrollViewer x:Name="ImageScroller"
                          ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="8"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          SizeChanged="ImageScroller_SizeChanged">
                <!-- Host is sized to the viewport so the image fits at 1x; zooming scales it beyond the viewport -->
                <Grid x:Name="ImageHost" Background="Transparent"
                      PointerWheelChanged="ImageHost_PointerWheelChanged"
                      PointerPressed="ImageHost_PointerPressed"
                      PointerMoved="ImageHost_PointerMoved"
                      PointerReleased="ImageHost_PointerReleased"
                      PointerCaptureLost="ImageHost_PointerReleased"
                      DoubleTapped="ImageHost_DoubleTapped">
                    <Image x:Name="ImageViewerControl"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />
                </Grid>
            </ScrollViewer>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Top Floating Overlay Header: shown while the pointer is over the preview (or a button has the focus) -->
        <Grid x:Name="HeaderOverlay" VerticalAlignment="Top" Padding="16,12" Background="#A01E1E1E" CornerRadius="8,8,0,0"
              ColumnDefinitions="*,Auto" Opacity="0" IsHitTestVisible="False" GotFocus="Overlay_GotFocus" LostFocus="Overlay_LostFocus">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Grid.OpacityTransition>
            <TextBlock loc:L.Uid="ImagePreview.ImageTitleTextBlock" x:Name="ImageTitleTextBlock" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="White" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button loc:L.Uid="ImagePreview.OpenInExplorerButton" x:Name="OpenInExplorerButton" Click="OpenInExplorerButton_Click" AutomationProperties.Name="Show in Explorer"
                        Background="#40FFFFFF" Foreground="White" BorderThickness="0" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE838;" FontSize="13" Foreground="White" />
                        <TextBlock loc:L.Uid="ImagePreview.TextBlock01" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button loc:L.Uid="ImagePreview.OpenImageExternalButton" x:Name="OpenImageExternalButton" Click="OpenImageExternalButton_Click" AutomationProperties.Name="Open in External App"
                        Background="#40FFFFFF" Foreground="White" BorderThickness="0" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="White" />
                        <TextBlock loc:L.Uid="ImagePreview.TextBlock02" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Bottom Floating Overlay Footer (Metadata): same hover behaviour as the header -->
        <Grid x:Name="FooterOverlay" VerticalAlignment="Bottom" Padding="16,8" Background="#A01E1E1E" CornerRadius="0,0,8,8"
              Opacity="0" IsHitTestVisible="False">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Grid.OpacityTransition>
            <TextBlock loc:L.Uid="ImagePreview.MetadataTextBlock" x:Name="MetadataTextBlock"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="#D0FFFFFF"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
