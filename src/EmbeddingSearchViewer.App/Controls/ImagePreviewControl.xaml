<UserControl
    x:Class="EmbeddingSearchViewer_App.Controls.ImagePreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
        <!-- Main Image: Occupies 100% of the viewport area, aspect ratio preserved, no scrolling -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
            <ScrollViewer x:Name="ImageScroller"
                          ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="8"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          SizeChanged="ImageScroller_SizeChanged">
                <!-- Host is sized to the viewport so the image fits at 1x; zooming scales it beyond the viewport -->
                <Grid x:Name="ImageHost" Background="Transparent"
                      PointerWheelChanged="ImageHost_PointerWheelChanged"
                      PointerPressed="ImageHost_PointerPressed"
                      PointerMoved="ImageHost_PointerMoved"
                      PointerReleased="ImageHost_PointerReleased"
                      PointerCaptureLost="ImageHost_PointerReleased"
                      DoubleTapped="ImageHost_DoubleTapped">
                    <Image x:Name="ImageViewerControl"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />
                </Grid>
            </ScrollViewer>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Top Floating Overlay Header -->
        <Grid VerticalAlignment="Top" Padding="16,12" Background="#A01E1E1E" CornerRadius="8,8,0,0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ImageTitleTextBlock" Text="画像プレビュー" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="White" TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="1" x:Name="OpenImageExternalButton" Click="OpenImageExternalButton_Click"
                    ToolTipService.ToolTip="既定のフォトアプリで開く" AutomationProperties.Name="Open in External App"
                    Background="#40FFFFFF" Foreground="White" BorderThickness="0" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="White" />
                    <TextBlock Text="外部アプリで開く" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Bottom Floating Overlay Footer (Metadata) -->
        <Grid VerticalAlignment="Bottom" Padding="16,8" Background="#A01E1E1E" CornerRadius="0,0,8,8">
            <TextBlock x:Name="MetadataTextBlock" Text="画像情報 (ホイールで拡大縮小 / ドラッグで移動 / ダブルクリックで切替)"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="#D0FFFFFF"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
