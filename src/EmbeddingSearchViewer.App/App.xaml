<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EmbeddingSearchViewer_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmbeddingSearchViewer_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" xmlns:converters="using:EmbeddingSearchViewer_App.Converters" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" xmlns:converters="using:EmbeddingSearchViewer_App.Converters" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" xmlns:converters="using:EmbeddingSearchViewer_App.Converters" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" xmlns:converters="using:EmbeddingSearchViewer_App.Converters" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" xmlns:converters="using:EmbeddingSearchViewer_App.Converters" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
