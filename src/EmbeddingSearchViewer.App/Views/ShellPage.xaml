<Page
    x:Class="EmbeddingSearchViewer_App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:EmbeddingSearchViewer_App.Localization"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded"
            PaneDisplayMode="LeftCompact"
            AutomationProperties.Name="Application Navigation">

            <NavigationView.MenuItems>
                <NavigationViewItem loc:L.Uid="Shell.NavigationViewItem01" Tag="SearchPage" AutomationProperties.Name="Search and Viewer">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Find" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem loc:L.Uid="Shell.NavigationViewItem02" Tag="LibraryPage" AutomationProperties.Name="Library Management">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem loc:L.Uid="Shell.NavigationViewItem03" Tag="ModelSetupPage" AutomationProperties.Name="Model Setup">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>


            <!-- Content Area -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Profile switcher: each profile has its own folders, index, history and cache -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="16,8,16,0">
                    <FontIcon Glyph="&#xE77B;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock loc:L.Uid="Shell.TextBlock01" VerticalAlignment="Center" />
                    <ComboBox x:Name="ProfileCombo"
                              MinWidth="180"
                              DisplayMemberPath="Name"
                              SelectionChanged="ProfileCombo_SelectionChanged"
                              AutomationProperties.Name="Profile" />
                    <Button loc:L.Uid="Shell.ProfileMenuButton" x:Name="ProfileMenuButton" Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                            AutomationProperties.Name="Profile actions">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem loc:L.Uid="Shell.MenuFlyoutItem01" Click="NewProfile_Click" />
                                <MenuFlyoutItem loc:L.Uid="Shell.MenuFlyoutItem02" Click="RenameProfile_Click" />
                                <MenuFlyoutItem loc:L.Uid="Shell.MenuFlyoutItem03" Click="DeleteProfile_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
