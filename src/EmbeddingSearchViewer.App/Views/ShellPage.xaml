<Page
    x:Class="EmbeddingSearchViewer_App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded"
            PaneDisplayMode="LeftCompact"
            AutomationProperties.Name="Application Navigation">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="検索 &amp; ビューア" Tag="SearchPage" AutomationProperties.Name="Search and Viewer">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Find" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="ライブラリ管理" Tag="LibraryPage" AutomationProperties.Name="Library Management">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="モデル" Tag="ModelSetupPage" AutomationProperties.Name="Model Setup">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>


            <!-- Content Area -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Page>
