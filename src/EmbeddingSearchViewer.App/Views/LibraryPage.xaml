<Page
    x:Class="EmbeddingSearchViewer_App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lib="using:EmbeddingSearchViewer.Infrastructure.Library"
    xmlns:loc="using:EmbeddingSearchViewer_App.Localization"
    xmlns:vm="using:EmbeddingSearchViewer_App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="20">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock loc:L.Uid="Library.TextBlock01" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock loc:L.Uid="Library.TextBlock02"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Inference Engine Card -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE968;" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock loc:L.Uid="Library.TextBlock03" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.IsIndexing, Mode=OneWay}" Width="24" Height="24" />
            </Grid>

            <!-- Library Statistics Section -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEC27;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock loc:L.Uid="Library.TextBlock04" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button loc:L.Uid="Library.Button01" Command="{x:Bind ViewModel.RefreshLibraryStatsCommand}"
                                Padding="8,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Refresh Stats">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock loc:L.Uid="Library.TextBlock05" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                        <Button loc:L.Uid="Library.Button02" Command="{x:Bind ViewModel.RemoveMissingFilesCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Padding="8,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Remove Missing Files">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock loc:L.Uid="Library.TextBlock06" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                        <Button loc:L.Uid="Library.Button03" Command="{x:Bind ViewModel.RemoveBlankImagesCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Padding="8,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Remove Blank Images">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                                <TextBlock loc:L.Uid="Library.TextBlock07" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                        <Button loc:L.Uid="Library.Button04" Click="ClearIndexButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Padding="8,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Clear Index">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE894;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock loc:L.Uid="Library.TextBlock08" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Stats Cards Grid -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                    <!-- Total Assets -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <TextBlock loc:L.Uid="Library.TextBlock09" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalIndexedAssets, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Images -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEB9F;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock loc:L.Uid="Library.TextBlock10" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.IndexedImageCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- PDFs -->
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEA90;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock loc:L.Uid="Library.TextBlock11" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.IndexedPdfCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Videos -->
                    <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE714;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock loc:L.Uid="Library.TextBlock12" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.IndexedVideoCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Office documents -->
                    <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock loc:L.Uid="Library.TextBlock20" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.IndexedDocumentCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Folder Management Section -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="12"
                  AllowDrop="True" DragOver="Folders_DragOver" Drop="Folders_Drop">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xED25;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock loc:L.Uid="Library.TextBlock13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox loc:L.Uid="Library.FolderSort" Grid.Column="1" SelectedIndex="{x:Bind ViewModel.FolderSortIndex, Mode=TwoWay}"
                              Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              AutomationProperties.Name="Folder Sort Order">
                        <ComboBoxItem loc:L.Uid="Library.FolderSortAdded" />
                        <ComboBoxItem loc:L.Uid="Library.FolderSortName" />
                        <ComboBoxItem loc:L.Uid="Library.FolderSortCount" />
                    </ComboBox>
                    <Button Grid.Column="2" Click="AddFolderButton_Click" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Add Folder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                            <TextBlock loc:L.Uid="Library.TextBlock14" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Folder List & Empty State -->
                <Grid Grid.Row="1">
                    <!-- Empty State Guide -->
                    <Border Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock loc:L.Uid="Library.TextBlock15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock loc:L.Uid="Library.TextBlock16"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Active Folder List -->
                    <ListView Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              ItemsSource="{x:Bind ViewModel.FolderItems, Mode=OneWay}"
                              MaxHeight="220" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderEntry">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="8,4" ColumnSpacing="10">
                                    <FontIcon Glyph="&#xED25;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" VerticalAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button loc:L.Uid="Library.Button05" Grid.Column="3" Click="RemoveFolderButton_Click" AutomationProperties.Name="Remove Folder"
                                            Background="Transparent" BorderThickness="0" Padding="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Action & Progress -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <ToggleSwitch loc:L.Uid="Library.ToggleSwitch01"
                                  IsOn="{x:Bind ViewModel.AutoIndex, Mode=TwoWay}" AutomationProperties.Name="Auto Index" />
                    <TextBlock loc:L.Uid="Library.TextBlock19"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="0">
                        <CheckBox loc:L.Uid="Library.CheckBox02" IsChecked="{x:Bind ViewModel.IndexImages, Mode=TwoWay}"
                                  AutomationProperties.Name="Index Images" />
                        <CheckBox loc:L.Uid="Library.CheckBox03" IsChecked="{x:Bind ViewModel.IndexPdfs, Mode=TwoWay}"
                                  AutomationProperties.Name="Index PDFs" />
                        <CheckBox loc:L.Uid="Library.CheckBox04" IsChecked="{x:Bind ViewModel.IndexVideos, Mode=TwoWay}"
                                  AutomationProperties.Name="Index Videos" />
                        <CheckBox loc:L.Uid="Library.CheckBox05" IsChecked="{x:Bind ViewModel.IndexDocuments, Mode=TwoWay}"
                                  AutomationProperties.Name="Index Documents" />
                    </StackPanel>
                    <ComboBox loc:L.Uid="Library.ComboBox01"
                              ItemsSource="{x:Bind ViewModel.VideoSegmentOptions}"
                              SelectedIndex="{x:Bind ViewModel.VideoSegmentIndex, Mode=TwoWay}"
                              AutomationProperties.Name="Video Segment Length" />
                    <CheckBox loc:L.Uid="Library.CheckBox01"
                              IsChecked="{x:Bind ViewModel.VideoAutoSegment, Mode=TwoWay}"
                              AutomationProperties.Name="Auto Adjust Video Segment Length" />
                    <TextBlock loc:L.Uid="Library.TextBlock17"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{x:Bind ViewModel.CurrentStatusMessage, Mode=OneWay}" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <Button loc:L.Uid="Library.Button06" Grid.Column="1"
                                Command="{x:Bind ViewModel.StartIndexingCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                AutomationProperties.Name="Start Indexing" />
                        <Button loc:L.Uid="Library.Button07" Grid.Column="2"
                                Command="{x:Bind ViewModel.StopIndexingCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay}"
                                AutomationProperties.Name="Stop Indexing" />
                    </Grid>

                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" Maximum="100" />

                    <!-- Estimated time left (empty until the speed is known) -->
                    <TextBlock Text="{x:Bind ViewModel.EtaText, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.EtaText, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />

                    <!-- How far each video being processed has come -->
                    <TextBlock Text="{x:Bind ViewModel.VideoProgressText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Files left out of the index because reading them failed repeatedly -->
            <Expander Header="{x:Bind ViewModel.ExcludedHeaderText, Mode=OneWay}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Visibility="{x:Bind ViewModel.HasExcluded, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock loc:L.Uid="Library.TextBlock18"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView ItemsSource="{x:Bind ViewModel.ExcludedFiles, Mode=OneWay}" MaxHeight="220" SelectionMode="None"
                              AutomationProperties.Name="Excluded Files">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="lib:ExcludedFile">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,4">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock Text="{x:Bind Error}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind FailedAtText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button loc:L.Uid="Library.Button10" Grid.Column="1" Tag="{x:Bind}" Click="RevealExcluded_Click"
                                            VerticalAlignment="Center" AutomationProperties.Name="Show in Explorer" />
                                    <Button loc:L.Uid="Library.Button08" Grid.Column="2" Tag="{x:Bind}" Click="RestoreExcluded_Click"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button loc:L.Uid="Library.Button09" Command="{x:Bind ViewModel.ClearExclusionsCommand}"
                            AutomationProperties.Name="Restore All Excluded Files" />
                </StackPanel>
            </Expander>

            <!-- Index / model mismatch -->
            <InfoBar loc:L.Uid="Library.InfoBar01" IsOpen="{x:Bind ViewModel.IndexModelWarning, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                     IsClosable="False" Severity="Warning"
                     Message="{x:Bind ViewModel.IndexModelWarning, Mode=OneWay}" />

            <!-- Error InfoBar -->
            <InfoBar Closed="ErrorInfoBar_Closed"
                     IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
