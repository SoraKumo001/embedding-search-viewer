<Page
    x:Class="EmbeddingSearchViewer_App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lib="using:EmbeddingSearchViewer.Infrastructure.Library"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="20">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="メディアライブラリ管理" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="PDFドキュメント、静止画、動画が存在するフォルダを追加して、EmbeddingGemma 2 によるインデックスを作成・管理します。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Inference Engine Card -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE968;" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="推論エンジン (EmbeddingGemma 2)" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.SidecarStatus, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.IsIndexing, Mode=OneWay}" Width="24" Height="24" />
            </Grid>

            <!-- Library Statistics Section -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEC27;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="インデックス済みファイル統計" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Command="{x:Bind ViewModel.RefreshLibraryStatsCommand}" ToolTipService.ToolTip="統計を再読み込み"
                                Padding="8,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Refresh Stats">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="更新" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.RemoveMissingFilesCommand}" ToolTipService.ToolTip="ディスク上に存在しないファイルをインデックスから除去"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Padding="8,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Remove Missing Files">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                <TextBlock Text="削除済みを除去" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.RemoveBlankImagesCommand}" ToolTipService.ToolTip="白紙(ほぼ一色)の画像をインデックスから除去 (ファイルは削除されません)"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Padding="8,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Remove Blank Images">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                                <TextBlock Text="白紙を除去" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Click="ClearIndexButton_Click" ToolTipService.ToolTip="インデックスをすべて削除 (ファイル自体は削除されません)"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Padding="8,4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Clear Index">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE894;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="クリア" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Stats Cards Grid -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <!-- Total Assets -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="総ファイル数" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalIndexedAssets, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Images -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEB9F;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="静止画" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.IndexedImageCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- PDFs -->
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEA90;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="PDF文書" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.IndexedPdfCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Videos -->
                    <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE714;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="動画" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.IndexedVideoCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Folder Management Section -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="12"
                  AllowDrop="True" DragOver="Folders_DragOver" Drop="Folders_Drop">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xED25;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="インデックス対象フォルダ" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="AddFolderButton_Click" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Add Folder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                            <TextBlock Text="フォルダを追加" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Folder List & Empty State -->
                <Grid Grid.Row="1">
                    <!-- Empty State Guide -->
                    <Border Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="対象フォルダがまだ登録されていません" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="「フォルダを追加」ボタンをクリックするか、フォルダをここにドラッグ&amp;ドロップしてください。"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Active Folder List -->
                    <ListView Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              ItemsSource="{x:Bind ViewModel.TargetFolders, Mode=OneWay}"
                              MaxHeight="220" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,4" ColumnSpacing="10">
                                    <FontIcon Glyph="&#xED25;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Click="RemoveFolderButton_Click" ToolTipService.ToolTip="このフォルダをリストから解除" AutomationProperties.Name="Remove Folder"
                                            Background="Transparent" BorderThickness="0" Padding="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Action & Progress -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <ToggleSwitch Header="フォルダを監視して自動でインデックスを更新"
                                  OnContent="オン (追加・変更・削除を自動反映)" OffContent="オフ"
                                  IsOn="{x:Bind ViewModel.AutoIndex, Mode=TwoWay}" AutomationProperties.Name="Auto Index" />
                    <ComboBox Header="動画の場面の間隔（1 場面につき 1 枚のフレームを検索の対象にします）"
                              ItemsSource="{x:Bind ViewModel.VideoSegmentOptions}"
                              SelectedIndex="{x:Bind ViewModel.VideoSegmentIndex, Mode=TwoWay}"
                              AutomationProperties.Name="Video Segment Length" />
                    <TextBlock Text="間隔を長くすると、長い動画の取り込みが速くなりますが、検索できる場面は粗くなります。変更は、これから取り込む動画に適用されます（取り込み済みの動画は、「クリア」してから作り直してください）。"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{x:Bind ViewModel.CurrentStatusMessage, Mode=OneWay}" VerticalAlignment="Center"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="インデックス作成を開始"
                                Command="{x:Bind ViewModel.StartIndexingCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                AutomationProperties.Name="Start Indexing" />
                        <Button Grid.Column="2" Content="中断"
                                Command="{x:Bind ViewModel.StopIndexingCommand}"
                                IsEnabled="{x:Bind ViewModel.IsIndexing, Mode=OneWay}"
                                AutomationProperties.Name="Stop Indexing" />
                    </Grid>

                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" Maximum="100" />

                    <!-- How far each video being processed has come -->
                    <TextBlock Text="{x:Bind ViewModel.VideoProgressText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Files left out of the index because reading them failed repeatedly -->
            <Expander Header="{x:Bind ViewModel.ExcludedHeaderText, Mode=OneWay}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Visibility="{x:Bind ViewModel.HasExcluded, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="読み込みを、何度か試しても失敗したファイルは、壊れている可能性が高いので、次回から、インデックスの対象から外しています。ファイルを直したり、置き換えたりして、サイズや更新日時が変わると、自動で、対象に戻ります。"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView ItemsSource="{x:Bind ViewModel.ExcludedFiles, Mode=OneWay}" MaxHeight="220" SelectionMode="None"
                              AutomationProperties.Name="Excluded Files">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="lib:ExcludedFile">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,4">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock Text="{x:Bind Error}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind FailedAtText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="対象に戻す" Tag="{x:Bind}" Click="RestoreExcluded_Click"
                                            ToolTipService.ToolTip="次回のインデックス作成で、もう一度、試します"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="すべて対象に戻す" Command="{x:Bind ViewModel.ClearExclusionsCommand}"
                            AutomationProperties.Name="Restore All Excluded Files" />
                </StackPanel>
            </Expander>

            <!-- Index / model mismatch -->
            <InfoBar IsOpen="{x:Bind ViewModel.IndexModelWarning, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                     IsClosable="False" Severity="Warning" Title="インデックスの再作成が必要です"
                     Message="{x:Bind ViewModel.IndexModelWarning, Mode=OneWay}" />

            <!-- Error InfoBar -->
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
