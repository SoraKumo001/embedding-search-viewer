<Page
    x:Class="EmbeddingSearchViewer_App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:EmbeddingSearchViewer_App.Localization"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="20">
            <!-- Header -->
            <TextBlock loc:L.Uid="Settings.TextBlock01" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- Embedding Engine Status -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                <TextBlock loc:L.Uid="Settings.TextBlock02" Grid.Row="0" FontWeight="SemiBold" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock loc:L.Uid="Settings.TextBlock03" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.HealthDetails, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button loc:L.Uid="Settings.Button01" Grid.Column="1" Command="{x:Bind ViewModel.CheckHealthCommand}" AutomationProperties.Name="Check Engine Status" />
                </Grid>
            </Grid>

            <!-- Search Options -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                <TextBlock loc:L.Uid="Settings.TextBlock04" Grid.Row="0" FontWeight="SemiBold" />

                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock loc:L.Uid="Settings.TextBlock05"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ComboBox SelectedValue="{x:Bind ViewModel.Search.TruncateDim, Mode=TwoWay}" AutomationProperties.Name="Vector Dimension">
                        <x:Int32>768</x:Int32>
                        <x:Int32>512</x:Int32>
                        <x:Int32>256</x:Int32>
                        <x:Int32>128</x:Int32>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6">
                    <Slider loc:L.Uid="Settings.Slider01" Minimum="0" Maximum="1" StepFrequency="0.05" TickFrequency="0.25" TickPlacement="Outside"
                            Value="{x:Bind ViewModel.Search.MinSimilarity, Mode=TwoWay}" AutomationProperties.Name="Minimum Similarity" />
                </StackPanel>

                <ToggleSwitch loc:L.Uid="Settings.ToggleSwitch01" Grid.Row="3"
                              IsOn="{x:Bind ViewModel.Search.EnableFts, Mode=TwoWay}" AutomationProperties.Name="Enable FTS" />
            </Grid>

            <!-- Language: a change takes effect the next time the app starts -->
            <StackPanel Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" Spacing="8">
                <TextBlock loc:L.Uid="Settings.LanguageTitle" FontWeight="SemiBold" />
                <TextBlock loc:L.Uid="Settings.LanguageHint" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" MinWidth="260" AutomationProperties.Name="Language">
                    <ComboBoxItem loc:L.Uid="Settings.LanguageAuto" />
                    <!-- Each language is named in its own language, so that it can be found whatever the app is showing -->
                    <ComboBoxItem Content="日本語" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.RestartRequired, Mode=OneWay}">
                    <TextBlock loc:L.Uid="Settings.RestartNeeded" VerticalAlignment="Center" />
                    <Button loc:L.Uid="Settings.RestartNow" Click="RestartNow_Click" AutomationProperties.Name="Restart Now" />
                </StackPanel>
            </StackPanel>

            <!-- App About -->
            <StackPanel Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" Spacing="6">
                <TextBlock loc:L.Uid="Settings.TextBlock06" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.AppVersionText}" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,8,0,0" />
                <TextBlock loc:L.Uid="Settings.TextBlock07"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
