<Page
    x:Class="EmbeddingSearchViewer_App.Views.ModelSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:EmbeddingSearchViewer_App.Localization"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock loc:L.Uid="ModelSetup.TextBlock01" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock loc:L.Uid="ModelSetup.TextBlock02"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Model info -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock loc:L.Uid="ModelSetup.TextBlock03" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton Padding="0" NavigateUri="{x:Bind ViewModel.SourceUrl}" Content="{x:Bind ViewModel.SourceText}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock loc:L.Uid="ModelSetup.TextBlock04" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalSizeText}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock loc:L.Uid="ModelSetup.TextBlock05" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.LocationText}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock loc:L.Uid="ModelSetup.TextBlock06" Grid.Row="3" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>

            <!-- Progress -->
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{x:Bind ViewModel.IsVerifying, Mode=OneWay}" />
                <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.DetailText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button Style="{ThemeResource AccentButtonStyle}" Content="{x:Bind ViewModel.DownloadButtonText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.DownloadCommand}"
                            Visibility="{x:Bind ViewModel.ShowDownloadButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsEnabled="{x:Bind ViewModel.CanDownload, Mode=OneWay}" AutomationProperties.Name="Download Model" />
                    <Button loc:L.Uid="ModelSetup.Button01" Command="{x:Bind ViewModel.CancelCommand}"
                            IsEnabled="{x:Bind ViewModel.IsDownloading, Mode=OneWay}" AutomationProperties.Name="Cancel Download" />
                    <Button loc:L.Uid="ModelSetup.Button02" Click="GoToSearch_Click" AutomationProperties.Name="Go To Search" />
                </StackPanel>
            </Grid>

            <InfoBar loc:L.Uid="ModelSetup.InfoBar01" IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                     IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
