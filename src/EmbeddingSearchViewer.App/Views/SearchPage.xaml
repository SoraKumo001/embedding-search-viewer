<Page
    x:Class="EmbeddingSearchViewer_App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EmbeddingSearchViewer.Core.Models"
    xmlns:controls="using:EmbeddingSearchViewer_App.Controls"
    xmlns:loc="using:EmbeddingSearchViewer_App.Localization"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*" Padding="24,12,24,24" RowSpacing="16"
          AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop" Background="Transparent">
        <!-- Top Search Bar Section -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16" CornerRadius="8">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <!-- Text Query -->
                <!-- Offers past query texts while typing; Enter (or choosing a suggestion) runs the search. -->
                <AutoSuggestBox loc:L.Uid="Search.SearchBox" x:Name="SearchBox" Grid.Column="0"
                                Text="{x:Bind ViewModel.QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                UpdateTextOnSelect="False"
                                TextChanged="SearchBox_TextChanged"
                                SuggestionChosen="SearchBox_SuggestionChosen"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                AutomationProperties.Name="Search Query" />

                <!-- Search History -->
                <Button loc:L.Uid="Search.Button01" Grid.Column="1" AutomationProperties.Name="Search History">
                    <FontIcon Glyph="&#xE81C;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="HistoryFlyout" Opening="HistoryFlyout_Opening" />
                    </Button.Flyout>
                </Button>

                <!-- Media Filter -->
                <ComboBox Grid.Column="2" SelectedIndex="{x:Bind ViewModel.SelectedMediaTypeIndex, Mode=TwoWay}"
                          AutomationProperties.Name="Media Filter">
                    <ComboBoxItem loc:L.Uid="Search.ComboBoxItem01" />
                    <ComboBoxItem loc:L.Uid="Search.ComboBoxItem02" />
                    <ComboBoxItem loc:L.Uid="Search.ComboBoxItem03" />
                    <ComboBoxItem loc:L.Uid="Search.ComboBoxItem04" />
                    <ComboBoxItem loc:L.Uid="Search.ComboBoxItem20" />
                </ComboBox>

                <!-- Query Image Picker Button -->
                <Button Grid.Column="3" Click="PickQueryImage_Click" AutomationProperties.Name="Search by Image">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                        <TextBlock loc:L.Uid="Search.TextBlock01" />
                    </StackPanel>
                </Button>

                <!-- Search Button -->
                <Button Grid.Column="4" Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        IsEnabled="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                        AutomationProperties.Name="Search">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock loc:L.Uid="Search.TextBlock02" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Query Image Indicator (if image search is active) -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto"
                  Visibility="{x:Bind ViewModel.QueryImagePath, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="8,4" CornerRadius="4">
                <FontIcon Glyph="&#xEB9F;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.QueryImagePath, Mode=OneWay}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button loc:L.Uid="Search.Button02" Grid.Column="2" Command="{x:Bind ViewModel.ClearQueryImageCommand}" AutomationProperties.Name="Clear Query Image">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <!-- Search Options -->
            <!-- Two lines, so that nothing is cut off when the window is narrow: the slider takes what is left on
                 the first, and the check boxes on the second share the width and wrap their text. -->
            <StackPanel Grid.Row="2" Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                    <CheckBox loc:L.Uid="Search.CheckBox01" Grid.Column="0" MinWidth="0"
                              IsChecked="{x:Bind ViewModel.EnableFts, Mode=TwoWay}" AutomationProperties.Name="Enable FTS" />
                    <Slider loc:L.Uid="Search.Slider01" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.05" MinWidth="80" MaxWidth="320"
                            HorizontalAlignment="Stretch"
                            Value="{x:Bind ViewModel.MinSimilarity, Mode=TwoWay}" AutomationProperties.Name="Minimum Similarity" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="72"
                               Text="{x:Bind ViewModel.MinSimilarityText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,Auto,*,*" ColumnSpacing="16" VerticalAlignment="Center">
                    <TextBlock loc:L.Uid="Search.TextBlock03" Grid.Column="0" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" AutomationProperties.Name="Sort Order">
                        <ComboBoxItem loc:L.Uid="Search.ComboBoxItem05" />
                        <ComboBoxItem loc:L.Uid="Search.ComboBoxItem06" />
                        <ComboBoxItem loc:L.Uid="Search.ComboBoxItem07" />
                    </ComboBox>
                    <CheckBox loc:L.Uid="Search.CheckBox02" Grid.Column="2" MinWidth="0"
                              IsChecked="{x:Bind ViewModel.GroupVideos, Mode=TwoWay}"
                              AutomationProperties.Name="Group Video Scenes" />
                    <CheckBox loc:L.Uid="Search.CheckBox03" Grid.Column="3" MinWidth="0"
                              IsChecked="{x:Bind ViewModel.SaveOptionsInHistory, Mode=TwoWay}"
                              AutomationProperties.Name="Save Search Options In History" />
                </Grid>
            </StackPanel>

            <!-- Metadata Filters -->
            <Expander loc:L.Uid="Search.Expander01" Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                    <CalendarDatePicker loc:L.Uid="Search.CalendarDatePicker01" Grid.Row="0" Grid.Column="0"
                                        Date="{x:Bind ViewModel.FilterDateFrom, Mode=TwoWay}" AutomationProperties.Name="Modified From" />
                    <CalendarDatePicker loc:L.Uid="Search.CalendarDatePicker02" Grid.Row="0" Grid.Column="1"
                                        Date="{x:Bind ViewModel.FilterDateTo, Mode=TwoWay}" AutomationProperties.Name="Modified To" />
                    <NumberBox loc:L.Uid="Search.NumberBox01" Grid.Row="0" Grid.Column="2" Minimum="0" Width="130"
                               Value="{x:Bind ViewModel.FilterMinSizeMb, Mode=TwoWay}" AutomationProperties.Name="Minimum Size MB" />
                    <NumberBox loc:L.Uid="Search.NumberBox02" Grid.Row="0" Grid.Column="3" Minimum="0" Width="130"
                               Value="{x:Bind ViewModel.FilterMaxSizeMb, Mode=TwoWay}" AutomationProperties.Name="Maximum Size MB" />
                    <TextBox loc:L.Uid="Search.TextBox01" Grid.Row="0" Grid.Column="4"
                             Text="{x:Bind ViewModel.FilterFolder, Mode=TwoWay}" AutomationProperties.Name="Folder Filter" />
                    <Button loc:L.Uid="Search.Button03" Grid.Row="0" Grid.Column="5" VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.ClearFiltersCommand}" AutomationProperties.Name="Clear Filters" />
                </Grid>
            </Expander>
        </Grid>

        <!-- Main Content Area: Master-Detail -->
        <Grid Grid.Row="1" ColumnDefinitions="380,*" ColumnSpacing="16">
            <!-- Left: Results List -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto"
                  Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                <!-- Result Count Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Bind ViewModel.ResultsHeaderText, Mode=OneWay}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                                  Width="20" Height="20" />
                </Grid>

                <!-- Error InfoBar -->
                <InfoBar Grid.Row="1" Margin="0,0,0,8" Closed="ErrorInfoBar_Closed"
                         IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                         Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <!-- Results ListView -->
                <ListView Grid.Row="2"
                          x:Name="ResultsListView"
                          ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}"
                          SelectionMode="Single"
                          SelectionChanged="ResultsListView_SelectionChanged"
                          AutomationProperties.Name="Search Results">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchResultItem">
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="10" Padding="4,6" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem loc:L.Uid="Search.MenuFlyoutItem01" Tag="{x:Bind}" Click="ResultMenu_OpenExternal_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem loc:L.Uid="Search.MenuFlyoutItem02" Tag="{x:Bind}" Click="ResultMenu_OpenFolder_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem loc:L.Uid="Search.MenuFlyoutItem03" Tag="{x:Bind}" Click="ResultMenu_CopyPath_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem loc:L.Uid="Search.MenuFlyoutItem04" Tag="{x:Bind}" Click="ResultMenu_SimilarSearch_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <!-- Thumbnail -->
                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image Source="{x:Bind Chunk.PreviewImagePath, Mode=OneTime}" Stretch="Uniform" />
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{x:Bind SimilarityPercentageText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock loc:L.Uid="Search.TextBlock04" Text="{x:Bind DuplicateText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{x:Bind DuplicateText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                    <TextBlock loc:L.Uid="Search.TextBlock05" Text="{x:Bind GroupText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{x:Bind GroupText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind Chunk.SnippetText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty / no-result state -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="12"
                            Visibility="{x:Bind ViewModel.EmptyStateText, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Right: Preview Detail Pane -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <!-- PDF Viewer -->
                <controls:PdfPreviewControl x:Name="PdfViewer" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <controls:DocumentPreviewControl x:Name="DocumentViewer" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Video Viewer -->
                <controls:VideoPreviewControl x:Name="VideoViewer" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Image Viewer -->
                <controls:ImagePreviewControl x:Name="ImageViewer" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Scenes of the selected video, and a search inside it -->
                <Grid Grid.Row="1" Margin="0,12,0,0" Padding="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8"
                      Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8"
                      Visibility="{x:Bind ViewModel.IsVideoSelected, Mode=OneWay}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{x:Bind ViewModel.ScenesHeaderText, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock loc:L.Uid="Search.TextBlock06" Grid.Column="1" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <ComboBox Grid.Column="2" SelectedIndex="{x:Bind ViewModel.SceneSortIndex, Mode=TwoWay}" AutomationProperties.Name="Scene Sort Order">
                            <ComboBoxItem loc:L.Uid="Search.ComboBoxItem08" />
                            <ComboBoxItem loc:L.Uid="Search.ComboBoxItem09" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBox loc:L.Uid="Search.SceneSearchBox" x:Name="SceneSearchBox"
                                 Text="{x:Bind ViewModel.SceneQueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SceneSearchBox_KeyDown"
                                 AutomationProperties.Name="Search Inside Video" />
                        <Button loc:L.Uid="Search.Button04" Grid.Column="1"
                                Command="{x:Bind ViewModel.SearchInVideoCommand}"
                                IsEnabled="{x:Bind ViewModel.IsSceneSearching, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                AutomationProperties.Name="Search In Video" />
                        <Button loc:L.Uid="Search.Button05" Grid.Column="2"
                                Command="{x:Bind ViewModel.ResetScenesCommand}"
                                AutomationProperties.Name="Reset Scenes" />
                        <ProgressRing Grid.Column="3" IsActive="{x:Bind ViewModel.IsSceneSearching, Mode=OneWay}" Width="20" Height="20" />
                    </Grid>

                    <InfoBar Grid.Row="2" Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.SceneErrorMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyConverter}}"
                             Message="{x:Bind ViewModel.SceneErrorMessage, Mode=OneWay}" />

                    <ListView Grid.Row="3" x:Name="SceneListView" MinHeight="150"
                              ItemsSource="{x:Bind ViewModel.Scenes, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedScene, Mode=TwoWay}"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              AutomationProperties.Name="Video Scenes">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultItem">
                                <StackPanel Width="180" Spacing="4" Padding="2">
                                    <Border Width="176" Height="99" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind Chunk.PreviewImagePath, Mode=OneTime}" Stretch="Uniform" />
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{x:Bind SceneTimeText}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind SimilarityPercentageText}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Empty State Placeholder -->
                <Grid x:Name="EmptyPreviewPlaceholder"
                      Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE721;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock loc:L.Uid="Search.TextBlock07"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
