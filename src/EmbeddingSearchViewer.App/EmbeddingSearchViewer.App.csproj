<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EmbeddingSearchViewer_App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <!-- Package type: None (Unpackaged zip, default) or MSIX (Microsoft Store) -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(WindowsPackageType)' != 'MSIX'">true</WindowsAppSDKSelfContained>
    <WinUISDKReferences Condition="'$(WindowsPackageType)' == 'MSIX'">true</WinUISDKReferences>
    <WinUISDKReferences Condition="'$(WindowsPackageType)' != 'MSIX'">false</WinUISDKReferences>
    <EnableMsixTooling Condition="'$(WindowsPackageType)' == 'MSIX'">true</EnableMsixTooling>
    <EnableMsixTooling Condition="'$(WindowsPackageType)' != 'MSIX'">false</EnableMsixTooling>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\AppIcon.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- FFmpeg decoder for videos the Windows media stack cannot read (webm, flv, HEVC without the codec pack, ...) -->
    <PackageReference Include="FFmpegInteropX.Desktop.FFmpeg" Version="7.0.100" />
    <PackageReference Include="FFmpegInteropX.Desktop.Lib" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.7.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EmbeddingSearchViewer.Core\EmbeddingSearchViewer.Core.csproj" />
    <ProjectReference Include="..\EmbeddingSearchViewer.Infrastructure\EmbeddingSearchViewer.Infrastructure.csproj" />
    <!--
      Built before the app, but never referenced: the worker is only ever started as a separate process. The worker is
      built framework-dependent so that this reference is allowed (a self-contained executable cannot be referenced
      by a non self-contained one: NETSDK1151). The self-contained copy that ships is produced by the publish target
      below.
    -->
    <ProjectReference Include="..\EmbeddingSearchViewer.FfmpegWorker\EmbeddingSearchViewer.FfmpegWorker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The FFmpeg worker is a process of its own, so its output is copied as one folder next to the app instead of being
    merged into the app's output: the two apps keep their own dependency graphs. This is the worker's normal (framework
    dependent) build output, which is enough to run it from bin\ on a machine with the .NET runtime. What ships (the
    zip, the installer and the MSIX) is replaced with a self-contained publish in IncludeFfmpegWorkerInPublish below.
    Only the files needed at run time are copied (no symbols, no import libraries).
  -->
  <Target Name="CopyFfmpegWorker" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\EmbeddingSearchViewer.FfmpegWorker\EmbeddingSearchViewer.FfmpegWorker.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="_FfmpegWorkerAssembly" />
    </MSBuild>
    <ItemGroup>
      <_FfmpegWorkerFiles Include="%(_FfmpegWorkerAssembly.RootDir)%(_FfmpegWorkerAssembly.Directory)**\*"
                          Exclude="%(_FfmpegWorkerAssembly.RootDir)%(_FfmpegWorkerAssembly.Directory)**\*.pdb;%(_FfmpegWorkerAssembly.RootDir)%(_FfmpegWorkerAssembly.Directory)**\*.lib" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfmpegWorkerFiles)" DestinationFolder="$(OutDir)FfmpegWorker\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Everything that is shipped needs a self-contained worker (the target machine has no .NET runtime), even though the
    worker project is framework-dependent so that the app can reference it. Running "dotnet publish" as its own process
    publishes the worker self-contained without the SDK comparing its SelfContained with the app's (NETSDK1151 never
    applies to it). The output goes to an intermediate folder, and its files replace the build copy in the publish list
    (this also feeds the MSIX payload, which collects the publish items).
  -->
  <Target Name="IncludeFfmpegWorkerInPublish" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(RuntimeIdentifier)' != '' and '$(DesignTimeBuild)' != 'true' and '$(IsPublishable)' == 'true'">
    <PropertyGroup>
      <_FfmpegWorkerPublishDir>$([MSBuild]::EnsureTrailingSlash('$(BaseIntermediateOutputPath)'))FfmpegWorkerPublish\</_FfmpegWorkerPublishDir>
      <!-- DOTNET_HOST_PATH is set by the .NET CLI; fall back to dotnet on PATH when MSBuild.exe (Visual Studio) is used. -->
      <_DotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_DotnetHost>
      <_DotnetHost Condition="'$(_DotnetHost)' == ''">dotnet</_DotnetHost>
    </PropertyGroup>
    <RemoveDir Directories="$(_FfmpegWorkerPublishDir)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="&quot;$(_DotnetHost)&quot; publish &quot;$(MSBuildThisFileDirectory)..\EmbeddingSearchViewer.FfmpegWorker\EmbeddingSearchViewer.FfmpegWorker.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) -p:Platform=$(Platform) --self-contained true --nologo -o &quot;$(_FfmpegWorkerPublishDir)&quot;" />
    <ItemGroup>
      <!-- Drop any worker files that a previous target may have put into the publish list (e.g. the build copy). -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
            Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('FfmpegWorker\'))" />
      <_FfmpegWorkerPublishFiles Include="$(_FfmpegWorkerPublishDir)**\*"
                                 Exclude="$(_FfmpegWorkerPublishDir)**\*.pdb;$(_FfmpegWorkerPublishDir)**\*.lib" />
      <ResolvedFileToPublish Include="@(_FfmpegWorkerPublishFiles)">
        <RelativePath>FfmpegWorker\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--
      No IL trimming: the app relies on reflection (dependency injection, MVVM source generators, JSON, ONNX Runtime,
      SkiaSharp, WinRT components), which the trimmer cannot see and would remove.
    -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!--
    Unpackaged WinUI 3: "dotnet publish" leaves out the compiled XAML (*.xbf) and the app's resource index (*.pri),
    which are only copied by a normal build. Without them the app exits at startup (0xC000027B).
  -->
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(WindowsPackageType)' != 'MSIX'">
    <ItemGroup>
      <_WinUIResource Include="$(OutDir)$(TargetName).pri" />
      <_WinUIResource Include="$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_WinUIResource)">
        <RelativePath>$([MSBuild]::MakeRelative('$(OutDir)', '%(_WinUIResource.FullPath)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!--
    Resolve duplicate onnxruntime.dll in MSIX payload between Microsoft.Windows.AI.MachineLearning and Microsoft.ML.OnnxRuntime.DirectML
  -->
  <Target Name="RemoveDuplicateOnnxRuntimePayload" BeforeTargets="_ComputeAppxPackagePayload">
    <ItemGroup>
      <PackagingOutputs Remove="@(PackagingOutputs)"
                        Condition="'%(PackagingOutputs.TargetPath)' == 'onnxruntime.dll' and $([System.String]::Copy('%(PackagingOutputs.FullPath)').ToLowerInvariant().Contains('microsoft.windows.ai.machinelearning'))" />
    </ItemGroup>
  </Target>
</Project>