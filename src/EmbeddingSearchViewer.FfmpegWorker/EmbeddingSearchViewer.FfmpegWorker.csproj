<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The FFmpeg frame worker: one process per video, started by ChildProcessFrameSource. FFmpeg's native objects only
    ever run inside this process, so several videos decoded at once cannot drive FFmpeg concurrently in one process
    (the 0xC0000374 heap corruption). Pictures cross the process boundary as JPEG files; stdout carries one line per
    finished segment ("SEG <index> <middleMs>") and one after opening the file ("DURATION <ms>").

    Framework-dependent on purpose: the app references this project, and a self-contained executable cannot be
    referenced by the app when it is built framework-dependent (NETSDK1151). The worker that ships therefore has to be
    published self-contained on its own: the app's publish target runs "dotnet publish" with SelfContained=true for
    this project and puts the result next to the app under FfmpegWorker\. The app's normal build copies this project's
    (framework-dependent) build output there, which is enough to run it on a machine that has the .NET runtime (a dev
    machine).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EmbeddingSearchViewer_FfmpegWorker</RootNamespace>
    <AssemblyName>EmbeddingSearchViewer.FfmpegWorker</AssemblyName>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!--
      No <SelfContained>true</SelfContained> here: the app's ProjectReference would fail with NETSDK1151. The
      shipped, self-contained copy is produced by the app's publish target (see EmbeddingSearchViewer.App.csproj).
      "dotnet publish -p:SelfContained=true" (a global property) still overrides this, so the worker can be
      published on its own.
    -->
    <!--
      The worker is never loaded as a library (the app only starts it as a separate process), so the SDK must not
      compare its SelfContained with the referencing project's: the app is framework-dependent in CI but self-contained
      when built through its publish profile (win-x64.pubxml). Without this, one of the two would fail with NETSDK1150
      or NETSDK1151.
    -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No trimming: FFmpegInteropX and SkiaSharp are reached through WinRT and native code. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same decoder and encoder the in-process FFmpeg source uses, so the frames look the same. -->
    <PackageReference Include="FFmpegInteropX.Desktop.FFmpeg" Version="7.0.100" />
    <PackageReference Include="FFmpegInteropX.Desktop.Lib" Version="2.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The segment plan and the frame file name come from Core, so parent and child plan identically. -->
    <ProjectReference Include="..\EmbeddingSearchViewer.Core\EmbeddingSearchViewer.Core.csproj" />
  </ItemGroup>

</Project>
